# Server-only. A classic PAT without scopes can query public GitHub data.
GITHUB_TOKEN=
# Persistent, writable directory. Mount this directory in Docker.
GITMANCER_DATA_DIR=./data
# Exact public origin for metadata and cross-origin POST protection.
APP_ORIGIN=http://localhost:3000
# Enable only if your reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=0
